# ==========================================
# PokeTokenBar Windows - .gitignore
# ==========================================

# Dependencias de NodeJS
node_modules/
package-lock.json.bak

# Pruebas internas, entornos de test y scripts de desarrollo (scratch)
scratch/
test_user_data/
test_companion*
graphify-out/

# Registros del sistema, logs y diagnósticos de depuración
*.log
app.log
electron_stdout.log
electron_stderr.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Persistencia de partida del usuario local y respaldos
# (Evita que la partida del desarrollador sobrescriba a los nuevos usuarios)
companion-state.json
companion-state.*.json
companion-state.purga-backup-*.json
test-companion-state.json
.agent-state.json

# Archivos internos y bitácoras de agentes de IA (solo en local)
CHANGELOG_AGENTS.md
PROJECT_STATE.md
ROADMAP_PROXIMA_SESION.md

# Capturas de pantalla temporales y archivos residuales en la raíz
# (Las capturas oficiales de la documentación se preservan en docs/screenshots/)
desktop_snap.png
screen_test.png
pet_preview*.png
clean_view_result*.png
clean_dex_result*.png
dex_mastery_*.png
gba_pc_box_*.png
pet_clean_verified.png

# Empaquetado y distribución de Electron
dist/
build/
out/
.electron/

# Variables de entorno y secretos
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos del Sistema Operativo Windows y macOS
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Configuraciones de editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
